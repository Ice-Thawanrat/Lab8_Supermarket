<!DOCTYPE html>
<html>
<head>

    <title>Edit Product</title>

    <link rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">

</head>

<body>

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-6">

            <div class="card">

                <div class="card-body">

                    <h2 class="mb-4">
                        Edit Product
                    </h2>

                    <form action="/edit/<%= product.id %>?_method=PUT"
                          method="POST"
                          enctype="multipart/form-data">

                        <input type="text"
                               name="name"
                               value="<%= product.name %>"
                               class="form-control mb-3"
                               required>

                        <input type="text"
                               name="category"
                               value="<%= product.category %>"
                               class="form-control mb-3"
                               required>

                        <input type="number"
                               name="price"
                               value="<%= product.price %>"
                               class="form-control mb-3"
                               min="0"
                               required>

                        <input type="number"
                               name="stock"
                               value="<%= product.stock %>"
                               class="form-control mb-3"
                               min="0"
                               required>

                        <div class="mb-3">

                            <img src="/uploads/<%= product.image %>"
                                 width="120">

                        </div>

                        <input type="file"
                               name="image"
                               class="form-control mb-3">

                        <button class="btn btn-success">
                            Update Product
                        </button>

                        <a href="/"
                           class="btn btn-secondary">

                            Cancel

                        </a>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

</body>
</html>
